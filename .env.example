# Mortise hub yapılandırması.
# Sunucuda `/opt/mortise/.env` olarak kopyalanır. `.env` git'e girmez.

# Syncthing imaj etiketi. Pin'li tutuluyor — `latest` sessiz sürüm
# atlaması ve yeniden üretilemeyen kurulum demek.
SYNCTHING_VERSION=2.1.5

# Konteynerin dosyaları hangi kullanıcı adına yazacağı.
# Sunucuda `id -u` ve `id -g` çıktısıyla doldur.
PUID=1000
PGID=1000

# Hub'ın config ve veri kökü. DEPO DIŞINDA kalmalı.
MORTISE_HOME=/opt/mortise

# Syncthing cihaz listesinde görünecek ad.
MORTISE_HOSTNAME=mortise-hub
